<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gpu-monitor">
  <schema id="org.gnome.shell.extensions.gpu-monitor" path="/org/gnome/shell/extensions/gpu-monitor/">
    <key name="update-interval" type="i">
      <default>1</default>
      <range min="1" max="10"/>
      <summary>Intervalo de atualização (s)</summary>
    </key>
    <key name="display-mode" type="s">
      <choices><choice value="nome"/><choice value="nome+percentual"/></choices>
      <default>'nome'</default>
      <summary>Texto ao lado do cilindro</summary>
    </key>
    <key name="panel-position" type="s">
      <choices><choice value="left"/><choice value="center"/><choice value="right"/></choices>
      <default>'right'</default>
      <summary>Posição no painel</summary>
    </key>
    <key name="panel-index" type="i">
      <default>0</default>
      <range min="0" max="20"/>
      <summary>Índice no painel</summary>
    </key>
  </schema>
</schemalist>
